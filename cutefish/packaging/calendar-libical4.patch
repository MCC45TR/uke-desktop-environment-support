+// Libical 4 owns recurrence rules by reference. Keep an independent copy so
+// display/iteration never mutates the event's stored RRULE.
+struct RecurrenceDeleter {
+    void operator()(icalrecurrencetype *rule) const { icalrecurrencetype_unref(rule); }
+};
+using Recurrence = std::unique_ptr<icalrecurrencetype, RecurrenceDeleter>;
+static Recurrence copyRule(icalproperty *property)
+{
+    Recurrence rule(icalrecurrencetype_clone(icalproperty_get_rrule(property)));
+    if (!rule)
+        throw std::bad_alloc();
+    return rule;
+}
